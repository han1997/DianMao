<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 点猫 · 日之罗盘 (Day Compass, 2026-09-20 redesign)
         细圆环 (terracotta container) + 45° 指向的菱形指针 (terracotta accent) +
         中心小圆点 (primary ink)。全部落在 66dp 自适应安全圆 (中心 54,54) 内。 -->
    <!-- dial ring: 圆环，外半径 27，内半径 25，fillType evenOdd 形成空洞 -->
    <path
        android:fillColor="#F5DED9"
        android:fillType="evenOdd"
        android:pathData="M81,54 A27,27 0 1 1 27,54 A27,27 0 1 1 81,54 Z M79,54 A25,25 0 1 1 29,54 A25,25 0 1 1 79,54 Z" />
    <!-- needle: 细长菱形，指向右上 45°，尖端距中心约 20，尾端距中心约 8 -->
    <path
        android:fillColor="#A84534"
        android:pathData="M68.1,39.9 L59.8,51.4 L48.3,59.7 L56.7,48.2 Z" />
    <!-- hub: 中心小圆点，压在指针根部 -->
    <path
        android:fillColor="#1E211F"
        android:pathData="M54,51.8 A2.2,2.2 0 1 1 54,56.2 A2.2,2.2 0 1 1 54,51.8 Z" />
</vector>
